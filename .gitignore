# ---------------------------------------------------------------------------
#  Build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
dist/
*.user
*.suo
.vs/
_ReSharper*/

# ---------------------------------------------------------------------------
#  Runtime data — NEVER commit these. They contain account cookies (encrypted,
#  but still private), downloaded Chromium, per-account browser profiles, logs.
# ---------------------------------------------------------------------------
data/
**/data/
error.log
*.log

# ---------------------------------------------------------------------------
#  Secrets — a stray token/credential file must never reach the repo
# ---------------------------------------------------------------------------
*.pfx
*.snk
secrets.json
appsettings.*.local.json
.env
.env.*

# ---------------------------------------------------------------------------
#  OS / editor cruft
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
*.swp
*~

# Dev-Build/Release-Skripte (nicht im oeffentlichen Repo)
publish.ps1
release.bat
release.ps1

# ---------------------------------------------------------------------------
#  Icon-Quelle — die lose 256x256 icon.png wird beim Build in src/AppIcon.cs
#  (base64) und src/Assets/app.ico eingebacken; die rohe PNG gehoert nicht ins
#  Repo. app.ico wird bewusst getrackt (ApplicationIcon im csproj).
# ---------------------------------------------------------------------------
icon.png

# Temp release notes. The changelog itself lives in CHANGELOG.md and IS tracked — the build
# embeds it, so leaving it out ships a build with no "What's new" content.
_relnotes_*.md
release_notes_v*.md

# Publish-Output
publish/

# Website (GitHub Pages) - lokal, nie committen (kann private Screenshots/Daten enthalten)
docs/
