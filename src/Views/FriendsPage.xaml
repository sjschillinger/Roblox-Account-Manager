<UserControl x:Class="RobloxAccountManager.Views.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
             xmlns:models="clr-namespace:RobloxAccountManager.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{DynamicResource Str.Friends.Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="14,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{DynamicResource Str.Friends.As}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox Width="230" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                          ctl:Ui.Placeholder="{DynamicResource Str.Friends.PickAccount}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Account}">
                            <StackPanel Orientation="Horizontal">
                                <ctl:AvatarView Width="20" Height="20" CornerRadius="5" ImageUrl="{Binding ThumbnailUrl}" NameText="{Binding Username}" />
                                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource MaskConverter}">
                                            <Binding Path="DisplayNameOrUser" />
                                            <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Refresh}"
                        Content="{DynamicResource Str.Common.Refresh}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="28,4,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Input.Search}" Height="32" ctl:Ui.Placeholder="{DynamicResource Str.Friends.Search}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <RadioButton GroupName="friendFilter" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.All}"
                             ctl:Ui.Badge="{Binding CountAll}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=All}" />
                <RadioButton GroupName="friendFilter" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.Online}"
                             ctl:Ui.Badge="{Binding CountOnline}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=Online}" />
                <RadioButton GroupName="friendFilter" Style="{StaticResource Chip}" Content="{DynamicResource Str.Accounts.Filter.InGame}"
                             ctl:Ui.Badge="{Binding CountInGame}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=InGame}" />
            </StackPanel>
        </Grid>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="28,0,28,22">
            <Grid>
                <ListBox Style="{StaticResource PlainList}" Padding="6" ItemsSource="{Binding Friends}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Friend}">
                            <Grid Height="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:AvatarView Width="36" Height="36" CornerRadius="8" PipSize="11" HorizontalAlignment="Left"
                                                ImageUrl="{Binding HeadshotUrl}" NameText="{Binding Username}" Presence="{Binding Presence}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource MaskConverter}">
                                                <Binding Path="DisplayNameOrUser" />
                                                <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource MaskConverter}">
                                                <Binding Path="AtUsername" />
                                                <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}" />
                                    <TextBlock Text="{Binding StatusLine}" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip="{Binding StatusLine}" />
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" ToolTip="{Binding SubPlaceTip}"
                                            Visibility="{Binding IsSubPlace, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Str.Presence.SubPlace}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Primary}" Height="30" ctl:Ui.Icon="{StaticResource Icon.Play}"
                                            Content="{DynamicResource Str.Friends.Join}" ToolTip="{DynamicResource Str.Friends.JoinTip}"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" ctl:Ui.Icon="{StaticResource Icon.External}"
                                            ToolTip="{DynamicResource Str.Friends.Profile}"
                                            Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Btn.Icon}" ctl:Ui.Icon="{StaticResource Icon.Copy}"
                                            ToolTip="{DynamicResource Str.Friends.CopyName}"
                                            Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource Icon.Friends}" Style="{StaticResource IconPath}" Width="26" Height="26"
                          Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource Str.Friends.LoadingShort}" Style="{StaticResource Text.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
