<Window x:Class="RobloxAccountManager.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="Height" Width="484" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border x:Name="Root" Margin="22" CornerRadius="{StaticResource RadiusLg}"
            Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            Effect="{StaticResource ShadowDialog}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
            MouseLeftButtonDown="Root_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="24,22,24,20">
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="Title" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" LineHeight="19"
                           Text="Message" Margin="0,8,0,0" />

                <Grid x:Name="InputHost" Margin="0,16,0,0">
                    <TextBox x:Name="Input" />
                    <StackPanel x:Name="PasswordHost" Visibility="Collapsed">
                        <PasswordBox x:Name="Password" PasswordChanged="Password_Changed" />
                        <PasswordBox x:Name="PasswordRepeat" Margin="0,8,0,0" Visibility="Collapsed" PasswordChanged="Password_Changed" />
                        <TextBlock x:Name="PasswordHint" Style="{StaticResource Text.Caption}" Margin="2,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,7,7"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Style="{StaticResource Btn.Secondary}" MinWidth="96" Margin="0,0,8,0"
                            Click="Cancel_Click" IsCancel="True" />
                    <Button x:Name="OkBtn" Style="{StaticResource Btn.Primary}" MinWidth="96" Click="Ok_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
