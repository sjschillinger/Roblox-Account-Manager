<UserControl x:Class="RobloxAccountManager.Views.Settings.NotificationsSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Notifications}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Notifications.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,22" />

        <TextBlock Text="{DynamicResource Str.Notify.InApp}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Notify.Toasts.Title}" Description="{DynamicResource Str.Notify.Toasts.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnableToasts}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Notify.Launch.Title}" Description="{DynamicResource Str.Notify.Launch.Desc}" IsEnabled="{Binding EnableToasts}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ToastOnLaunch}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Notify.Crash.Title}" Description="{DynamicResource Str.Notify.Crash.Desc}" IsEnabled="{Binding EnableToasts}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ToastOnCrash}" />
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <TextBlock Text="Discord" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Webhook.Url.Title}" Description="{DynamicResource Str.Webhook.Url.Desc}" IsStacked="True">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" ctl:Ui.Placeholder="https://discord.com/api/webhooks/…"
                                     Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" Content="{DynamicResource Str.Webhook.Test}"
                                    Command="{Binding TestWebhookCommand}" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Str.Webhook.Invalid}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding WebhookValid, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Webhook.Connect.Title}" Description="{DynamicResource Str.Webhook.Connect.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyOnConnect}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Webhook.Crash.Title}" Description="{DynamicResource Str.Webhook.Crash.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyOnCrash}" />
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>
    </StackPanel>
</UserControl>
