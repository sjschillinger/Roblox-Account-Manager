<UserControl x:Class="RobloxAccountManager.Views.Settings.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.General}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.General.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,22" />

        <TextBlock Text="{DynamicResource Str.General.Language}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.General.Language.Title}" Description="{DynamicResource Str.General.Language.Desc}">
                    <ComboBox Width="220" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Language}" />
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <TextBlock Text="{DynamicResource Str.General.Startup}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.General.StartWithWindows}" Description="{DynamicResource Str.General.StartWithWindows.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.General.StartMinimized}" Description="{DynamicResource Str.General.StartMinimized.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.General.CloseToTray}" Description="{DynamicResource Str.General.CloseToTray.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" />
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <TextBlock Text="{DynamicResource Str.General.Shortcuts}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" x:Key="Sc">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Row="0" Text="{DynamicResource Str.Shortcut.Palette}" Style="{StaticResource Sc}" />
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl K" /></Border>
                <TextBlock Grid.Row="1" Text="{DynamicResource Str.Shortcut.Add}" Style="{StaticResource Sc}" />
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl N" /></Border>
                <TextBlock Grid.Row="2" Text="{DynamicResource Str.Shortcut.Pages}" Style="{StaticResource Sc}" />
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl 1 – 5" /></Border>
                <TextBlock Grid.Row="3" Text="{DynamicResource Str.Shortcut.Lock}" Style="{StaticResource Sc}" />
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl L" /></Border>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Str.Shortcut.Search}" Style="{StaticResource Sc}" />
                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl F" /></Border>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource Str.Shortcut.Launch}" Style="{StaticResource Sc}" />
                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Kbd}"><TextBlock Text="Enter" /></Border>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{DynamicResource Str.Shortcut.Tick}" Style="{StaticResource Sc}" />
                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Kbd}"><TextBlock Text="Space / Ctrl+Click" /></Border>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="{DynamicResource Str.Shortcut.Refresh}" Style="{StaticResource Sc}" />
                <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource Kbd}"><TextBlock Text="F5" /></Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
