<UserControl x:Class="RobloxAccountManager.Views.Settings.IntegrationsSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Integrations}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Integrations.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,22" />

        <Grid Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str.Api.Section}" Style="{StaticResource Text.Section}" Margin="2,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding WebApiStatus}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Api.Enable.Title}" Description="{DynamicResource Str.Api.Enable.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WebApiEnabled}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Api.Port.Title}" Description="{DynamicResource Str.Api.Port.Desc}">
                    <TextBox Style="{StaticResource Input.Number}" Text="{Binding WebApiPort}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Api.Token.Title}" Description="{DynamicResource Str.Api.Token.Desc}" IsStacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TokenBox" FontFamily="{StaticResource MonoFont}" IsHitTestVisible="False" Focusable="False" />
                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Copy}"
                                Content="{DynamicResource Str.Common.Copy}" Command="{Binding CopyWebApiTokenCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Refresh}"
                                Content="{DynamicResource Str.Api.Regenerate}" Command="{Binding GenerateWebApiTokenCommand}" />
                    </Grid>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Api.Cookie.Title}" Description="{DynamicResource Str.Api.Cookie.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WebApiAllowCookieRead}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Api.Endpoints}" Description="{DynamicResource Str.Api.Endpoints.Desc}" IsStacked="True">
                    <Border Style="{StaticResource Panel.Inset}">
                        <TextBox Text="{Binding WebApiEndpoints, Mode=OneWay}" IsReadOnly="True" Height="Auto" Padding="0" BorderThickness="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                 Background="Transparent" TextWrapping="NoWrap" />
                    </Border>
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <Grid Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str.Plugins.Section}" Style="{StaticResource Text.Section}" Margin="2,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PluginStatus}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border Style="{StaticResource Panel}">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Plugins.Enable.Title}" Description="{DynamicResource Str.Plugins.Enable.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnablePlugins}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Plugins.Folder.Title}" Description="{DynamicResource Str.Plugins.Folder.Desc}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource Str.Common.OpenFolder}" Command="{Binding OpenPluginsFolderCommand}" />
                        <Button Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Content="{DynamicResource Str.Plugins.Reload}" Command="{Binding ReloadPluginsCommand}"
                                IsEnabled="{Binding EnablePlugins}" />
                    </StackPanel>
                </ctl:SettingItem>
                <ItemsControl ItemsSource="{Binding Plugins}" Focusable="False" Visibility="{Binding EnablePlugins, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dot" Style="{StaticResource StatusDot}" Fill="{DynamicResource SuccessBrush}" Margin="0,6,12,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium">
                                        <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock x:Name="err" Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    <Setter TargetName="err" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ctl:DividerStack>
        </Border>
        <TextBlock Text="{DynamicResource Str.Plugins.Note}" Style="{StaticResource Text.Caption}" Margin="2,12,0,0" />
    </StackPanel>
</UserControl>
