<UserControl x:Class="RobloxAccountManager.Views.Settings.NetworkSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Network}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Network.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,22" />

        <TextBlock Text="{DynamicResource Str.Proxy.Section}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Proxy.Enable.Title}" Description="{DynamicResource Str.Proxy.Enable.Desc}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnableProxy}" />
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Proxy.Address.Title}" Description="{DynamicResource Str.Proxy.Address.Desc}" IsStacked="True">
                    <StackPanel>
                        <TextBox FontFamily="{StaticResource MonoFont}" ctl:Ui.Placeholder="socks5://127.0.0.1:1080"
                                 Text="{Binding ProxyAddress, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="{DynamicResource Str.Proxy.Invalid}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding ProxyValid, Converter={StaticResource InverseBoolToVis}}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox ctl:Ui.Placeholder="{DynamicResource Str.Proxy.Username}" Text="{Binding ProxyUsername, UpdateSourceTrigger=LostFocus}" />
                            <PasswordBox x:Name="ProxyPasswordBox" Grid.Column="2" ctl:Ui.Placeholder="{DynamicResource Str.Proxy.Password}"
                                         PasswordChanged="ProxyPassword_Changed" />
                            <Button Grid.Column="3" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Signal}"
                                    Content="{DynamicResource Str.Proxy.Test}" Command="{Binding TestProxyCommand}" />
                        </Grid>
                    </StackPanel>
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>
        <TextBlock Text="{DynamicResource Str.Proxy.Note}" Style="{StaticResource Text.Caption}" Margin="2,0,0,0" />
    </StackPanel>
</UserControl>
