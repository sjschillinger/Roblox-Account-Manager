<UserControl x:Class="RobloxAccountManager.Views.Settings.AppearanceSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
             xmlns:vm="clr-namespace:RobloxAccountManager.ViewModels">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Appearance}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Str.Settings.Cat.Appearance.Desc}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,4,0,22" />

        <TextBlock Text="{DynamicResource Str.Appearance.Theme}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
            <ctl:DividerStack>
                <ctl:SettingItem Title="{DynamicResource Str.Appearance.Mode}" Description="{DynamicResource Str.Appearance.Mode.Desc}">
                    <Border Style="{StaticResource Segmented}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="mode" Style="{StaticResource Segment}" ctl:Ui.Icon="{StaticResource Icon.Moon}"
                                         Content="{DynamicResource Str.Appearance.Mode.Dark}"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Dark}" />
                            <RadioButton GroupName="mode" Style="{StaticResource Segment}" ctl:Ui.Icon="{StaticResource Icon.Sun}"
                                         Content="{DynamicResource Str.Appearance.Mode.Light}"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Light}" />
                            <RadioButton GroupName="mode" Style="{StaticResource Segment}" ctl:Ui.Icon="{StaticResource Icon.Monitor}"
                                         Content="{DynamicResource Str.Appearance.Mode.System}"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EqualsToBool}, ConverterParameter=System}" />
                        </StackPanel>
                    </Border>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Appearance.Accent}" Description="{DynamicResource Str.Appearance.Accent.Desc}" IsStacked="True">
                    <ItemsControl ItemsSource="{Binding Accents}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccentChoice}">
                                <RadioButton GroupName="accent" Margin="0,0,10,0" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                             Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" CornerRadius="{StaticResource RadiusMd}" Padding="10,7" BorderThickness="1"
                                                    BorderBrush="{DynamicResource HairlineStrongBrush}" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="16" Height="16" Fill="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                                             Stroke="{DynamicResource HairlineStrongBrush}" StrokeThickness="1" />
                                                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctl:SettingItem>
                <ctl:SettingItem Title="{DynamicResource Str.Appearance.Density}" Description="{DynamicResource Str.Appearance.Density.Desc}">
                    <Border Style="{StaticResource Segmented}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="density2" Style="{StaticResource Segment}" ctl:Ui.Icon="{StaticResource Icon.Rows}"
                                         Content="{DynamicResource Str.Accounts.Density.Comfortable}"
                                         IsChecked="{Binding IsCompact, Converter={StaticResource InverseBool}}" />
                            <RadioButton GroupName="density2" Style="{StaticResource Segment}" ctl:Ui.Icon="{StaticResource Icon.List}"
                                         Content="{DynamicResource Str.Accounts.Density.Compact}" IsChecked="{Binding IsCompact}" />
                        </StackPanel>
                    </Border>
                </ctl:SettingItem>
            </ctl:DividerStack>
        </Border>

        <Grid Margin="2,0,0,10">
            <TextBlock Text="{DynamicResource Str.Appearance.Colors}" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{DynamicResource Str.Appearance.Colors.Reset}"
                        Command="{Binding ResetThemeCommand}" Visibility="{Binding HasCustomColors, Converter={StaticResource BoolToVis}}" />
                <ToggleButton x:Name="ShowEditor" Style="{StaticResource Chip}" Margin="6,0,0,0" Content="{DynamicResource Str.Appearance.Colors.Edit}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource Str.Appearance.Colors.Desc}" Style="{StaticResource Text.Caption}" Margin="2,0,0,12" />
        <Border Style="{StaticResource Panel}" Padding="18,12" Visibility="{Binding IsChecked, ElementName=ShowEditor, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding ThemeColors}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThemeColorRow}">
                        <Grid Margin="0,4,18,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="sw" Width="22" Height="22" CornerRadius="{StaticResource RadiusSm}" BorderThickness="1"
                                    BorderBrush="{DynamicResource HairlineStrongBrush}" Background="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBox Grid.Column="2" Width="96" Height="30" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter TargetName="sw" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="sw" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
