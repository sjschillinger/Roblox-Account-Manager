<Window x:Class="RobloxAccountManager.Views.ChromiumDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="CloakBrowser"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Width="504" SizeToContent="Height" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border x:Name="Root" Margin="22" CornerRadius="{StaticResource RadiusLg}"
            Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            Effect="{StaticResource ShadowDialog}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="24,22,24,22">
                <TextBlock Text="{DynamicResource Str.Chromium.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Str.Chromium.Body}" Style="{StaticResource Text.Secondary}" LineHeight="19" Margin="0,8,0,20" />

                <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" Height="6" />
                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="PhaseText" Style="{StaticResource Text.Secondary}" Margin="0,0,120,0" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,11,11"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Button x:Name="CancelBtn" Style="{StaticResource Btn.Secondary}" MinWidth="96" HorizontalAlignment="Right"
                        Content="{DynamicResource Str.Common.Cancel}" Click="Cancel_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
