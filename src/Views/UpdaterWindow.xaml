<Window x:Class="RobloxAccountManager.Views.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="504" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border x:Name="Root" Margin="22" CornerRadius="{StaticResource RadiusLg}"
            Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            Effect="{StaticResource ShadowDialog}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="24,22,24,22">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HeaderText" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Style="{StaticResource Text.Body}" Margin="0,18,0,0" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Text.Caption}" Margin="0,4,0,14" MinHeight="16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock x:Name="PercentText" Grid.Column="1" Margin="12,0,0,0" MinWidth="40" Style="{StaticResource Text.Caption}"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,11,11"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartAnywayButton" Style="{StaticResource Btn.Secondary}" Visibility="Collapsed" Margin="0,0,8,0" Click="StartAnyway_Click" />
                    <Button x:Name="RetryButton" Style="{StaticResource Btn.Primary}" Visibility="Collapsed" Margin="0,0,8,0" Click="Retry_Click" />
                    <Button x:Name="CancelButton" Style="{StaticResource Btn.Secondary}" MinWidth="92" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
