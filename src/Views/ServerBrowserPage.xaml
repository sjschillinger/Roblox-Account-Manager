<UserControl x:Class="RobloxAccountManager.Views.ServerBrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
             xmlns:models="clr-namespace:RobloxAccountManager.Models">

    <UserControl.Resources>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,0,150,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{DynamicResource Str.Servers.Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="14,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Search bar + game -->
        <Grid Grid.Row="1" Margin="28,4,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Height="34" Text="{Binding PlaceIdText, UpdateSourceTrigger=PropertyChanged}" KeyDown="PlaceBox_KeyDown"
                     ctl:Ui.Icon="{StaticResource Icon.Gamepad}" ctl:Ui.Placeholder="{DynamicResource Str.Launch.PlacePlaceholder}"
                     Background="{DynamicResource SurfaceBrush}" />
            <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Search}"
                    Content="{DynamicResource Str.Servers.Load}" Command="{Binding RefreshCommand}" />

            <Grid Grid.Column="2" Margin="18,0,12,0" VerticalAlignment="Center" Visibility="{Binding HasPlace, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="7" Background="{DynamicResource SurfaceAltBrush}">
                    <Border CornerRadius="7">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding PlaceIcon, Converter={StaticResource UrlToImage}}" />
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PlaceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" ToolTip="{Binding SubPlaceTip}"
                                Visibility="{Binding IsSubPlace, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Str.Presence.SubPlace}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding PlaceCreator}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{DynamicResource Str.Servers.HideFull}" IsChecked="{Binding HideFull}" Margin="0,0,14,0" />
                <Border Style="{StaticResource Segmented}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="serverSort" Style="{StaticResource Segment}" Content="{DynamicResource Str.Servers.Sort.Players}"
                                     IsChecked="{Binding SortMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Players}" />
                        <RadioButton GroupName="serverSort" Style="{StaticResource Segment}" Content="{DynamicResource Str.Servers.Sort.Empty}"
                                     IsChecked="{Binding SortMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Empty}" />
                        <RadioButton GroupName="serverSort" Style="{StaticResource Segment}" Content="{DynamicResource Str.Servers.Sort.Ping}"
                                     IsChecked="{Binding SortMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Ping}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="28,0,28,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="22,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.Servers.Column.Players}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.Servers.Column.Server}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource Str.Servers.Column.Ping}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="FPS" Style="{StaticResource ColumnHeader}" />
                </Grid>
                <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" Padding="6" ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}" MouseDoubleClick="ServerList_MouseDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                            <Setter Property="Padding" Value="16,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GameServer}">
                            <Grid x:Name="row" Height="36" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="120" Height="5" VerticalAlignment="Center">
                                        <Border CornerRadius="3" Background="{DynamicResource HairlineStrongBrush}" />
                                        <Border CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource TextSecondaryBrush}"
                                                Width="{Binding Fill, Converter={StaticResource FillToWidth}, ConverterParameter=120}" />
                                    </Grid>
                                    <TextBlock Text="{Binding PlayingDisplay}" Margin="12,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding PingDisplay}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding FpsDisplay}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel x:Name="actions" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0">
                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" ctl:Ui.Icon="{StaticResource Icon.Link}"
                                            ToolTip="{DynamicResource Str.Servers.CopyLink}"
                                            Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" ctl:Ui.Icon="{StaticResource Icon.Copy}"
                                            ToolTip="{DynamicResource Str.Servers.CopyJob}"
                                            Command="{Binding DataContext.CopyJobIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Btn.Primary}" Height="28" Margin="6,0,0,0" ctl:Ui.Icon="{StaticResource Icon.Play}"
                                            Content="{DynamicResource Str.Servers.Join}"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="actions" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="actions" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <Path Data="{StaticResource Icon.Servers}" Style="{StaticResource IconPath}" Width="26" Height="26"
                          Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Str.Servers.Empty.Title}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="{DynamicResource Str.Servers.Empty.Body}" Style="{StaticResource Text.Caption}" FontSize="12.5" TextAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{DynamicResource Str.Servers.LoadingShort}" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

                <!-- footer: who joins -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.Servers.JoinAs}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" />
                        <ComboBox Width="240" ItemsSource="{Binding Accounts}" SelectedItem="{Binding JoinAccount, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Account}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:AvatarView Width="20" Height="20" CornerRadius="5" ImageUrl="{Binding ThumbnailUrl}" NameText="{Binding Username}" Presence="{Binding Presence}" PipSize="7" RingBrush="{DynamicResource ElevatedBrush}" />
                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource MaskConverter}">
                                                    <Binding Path="DisplayNameOrUser" />
                                                    <Binding Path="DataContext.MaskUsernames" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Str.Servers.JoinHint}" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
