<UserControl x:Class="RobloxAccountManager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
             xmlns:vm="clr-namespace:RobloxAccountManager.ViewModels"
             xmlns:s="clr-namespace:RobloxAccountManager.Views.Settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,0,150,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                <TextBlock Text="{DynamicResource Str.Settings.Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="14,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Grid Grid.Column="0" Margin="20,4,8,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource Input.Search}" Height="32" Margin="8,0,0,12"
                         ctl:Ui.Placeholder="{DynamicResource Str.Settings.Search}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Margin" Value="8,1,0,1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsCategory}">
                            <StackPanel Orientation="Horizontal" Height="34">
                                <Path x:Name="ic" Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                      Style="{StaticResource IconPath}" Width="16" Height="16" />
                                <TextBlock x:Name="tx" Text="{Binding Title}" Margin="11,0,0,0" VerticalAlignment="Center"
                                           FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="ic" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Content -->
            <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <!-- Every category gets the same width (up to 860), whatever its content measures. -->
                <Grid Margin="24,4,32,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="860" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=General}">
                        <s:GeneralSettings />
                        <s:AppearanceSettings Margin="0,12,0,0" />
                        <s:HotkeysSettings Margin="0,12,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Launching}">
                        <s:LaunchingSettings />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=KeepRunning}">
                        <s:KeepRunningSettings />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=AntiAfk}">
                        <s:AntiAfkSettings />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Performance}">
                        <s:GraphicsSettings />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Notifications}">
                        <s:NotificationsSettings />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=AccountsSecurity}">
                        <s:SecuritySettings />
                        <s:LiveDataSettings Margin="0,12,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Advanced}">
                        <s:BrowserSettings />
                        <s:NetworkSettings Margin="0,12,0,0" />
                        <s:IntegrationsSettings Margin="0,12,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedKey, Converter={StaticResource EqualsToVis}, ConverterParameter=UpdatesLogs}">
                        <s:UpdatesSettings />
                        <s:DiagnosticsSettings Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
