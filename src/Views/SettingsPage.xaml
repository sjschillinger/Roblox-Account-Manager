<UserControl x:Class="RobloxAccountManager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,8,24,24" MaxWidth="720" HorizontalAlignment="Left">

            <!-- ===== Launch ===== -->
            <TextBlock Text="Launch" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Multi-instance" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Run more than one Roblox client at the same time." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding EnableMultiInstance}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Unlock launches started outside the app" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Clears Roblox's per-client lock as well, so the Play button on roblox.com, the Roblox home screen and Discord invites open their own client instead of taking over the one already running."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding CloseSingletonEvent}" IsEnabled="{Binding EnableMultiInstance}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Manage external clients" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Let Anti-AFK, the RAM monitor and the window grid also see clients this app did not launch."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AdoptExternalClients}" IsEnabled="{Binding EnableMultiInstance}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <StackPanel Margin="16,14">
                        <TextBlock Text="{Binding MultiInstanceStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Fix multi-instance now" Command="{Binding FixMultiInstanceCommand}"
                                    Style="{StaticResource GhostButton}" />
                            <Button Content="Restart as administrator" Command="{Binding RestartElevatedCommand}"
                                    Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Visibility="{Binding ShowElevatePrompt, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Close previous client" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="When relaunching an account, close its earlier window first." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoCloseLastProcess}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Launch delay" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Seconds to wait between each account when launching several." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding AccountJoinDelay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Smart Join picks emptiest server" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Otherwise a random non-full public server is chosen." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ShuffleLowestServer}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Server scan pages" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="How many pages (×100 servers) Smart Join scans." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding ShufflePageCount, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Performance ===== -->
            <TextBlock Text="Performance" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Unlock FPS" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Writes a ClientAppSettings FPS cap before launching." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding UnlockFps}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="FPS cap" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Target frame rate when Unlock FPS is on." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding MaxFps, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Live data ===== -->
            <TextBlock Text="Live data" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Show avatars" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Load headshot thumbnails for each account." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowThumbnails}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Show presence" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Display online / in-game status." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowPresence}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Show Robux" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Fetch each account's Robux balance." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowRobux}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Track economy" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Also fetch collectible RAP and Premium membership. Slower — one extra pass per account."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding TrackEconomy}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Presence refresh" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Seconds between dashboard presence polls." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding PresencePollSeconds, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Automation ===== -->
            <TextBlock Text="Automation" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Anti-AFK -->
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Anti-AFK" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Keeps running clients from being idle-kicked: focuses each one, sends a single key tap, then returns you to what you were doing. One input per interval — it does not play the game for you."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AntiAfkEnabled}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Interval" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Minutes between anti-AFK passes." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding AntiAfkEnabled}"
                                 Text="{Binding AntiAfkIntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Key to tap" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Space resets Roblox's idle timer most reliably; F13 is a no-op in nearly every game."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding AntiAfkEnabled}"
                                  ItemsSource="{Binding AntiAfkKeys}" SelectedItem="{Binding AntiAfkKey}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Give focus back" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Return to the window you were using after each pass." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AntiAfkRestoreFocus}" IsEnabled="{Binding AntiAfkEnabled}" />
                    </Grid>
                    <StackPanel Margin="16,0,16,14">
                        <Button Content="Run one pass now" Command="{Binding TestAntiAfkCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource HairlineStrongBrush}" Margin="16,0" />

                    <!-- Crash watchdog -->
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Crash watchdog" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Notices when a tracked client closes or crashes. Accounts with &quot;Auto-rejoin&quot; on (Accounts → details) are relaunched into the same server, with a brake that stops after 3 crashes in 10 minutes."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding WatchdogEnabled}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Check every" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Seconds between client checks." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding WatchdogEnabled}"
                                 Text="{Binding WatchdogCheckSeconds, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource HairlineStrongBrush}" Margin="16,0" />

                    <!-- RAM monitor -->
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="RAM monitor" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Samples how much memory each running client uses." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding RamMonitorEnabled}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Sample every" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Seconds between memory samples." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding RamMonitorEnabled}"
                                 Text="{Binding RamMonitorSeconds, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Close clients over the limit" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Kills any client whose working set exceeds the cap below. Off by default — this ends the session without warning."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoCloseOnHighRam}" IsEnabled="{Binding RamMonitorEnabled}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Per-client limit (MB)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Working-set cap for a single Roblox client." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding AutoCloseOnHighRam}"
                                 Text="{Binding RamLimitMb, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Auto-trim memory" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Periodically hands each client's idle memory back to Windows. The pages come back when the client needs them again, so this is not a permanent saving — it helps when several clients are open and the machine starts to run short."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoTrimEnabled}" IsEnabled="{Binding RamMonitorEnabled}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Trim every" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Minutes between automatic trims." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding AutoTrimEnabled}"
                                 Text="{Binding AutoTrimMinutes, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <StackPanel Margin="16,0,16,14">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10">
                            <TextBlock Text="{Binding RamStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" FontFamily="Consolas" />
                        </Border>
                        <Button Content="Trim now" Command="{Binding TrimRamCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="Pages every tracked client's idle memory out to the standby list" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== FastFlags ===== -->
            <TextBlock Text="FastFlags" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Apply FastFlags" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Writes ClientAppSettings.json into every installed Roblox version before each launch. Unknown or mistyped flags are ignored by the client, but a bad value can stop it starting — clear them if a launch misbehaves."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ApplyFFlags}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Uncap frame rate" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Raises the task-scheduler target to the FPS cap set under Performance." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding FFlagUnlockFps}" IsEnabled="{Binding ApplyFFlags}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Disable telemetry" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Turns off the client's telemetry event reporting." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding FFlagDisableTelemetry}" IsEnabled="{Binding ApplyFFlags}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Force voxel lighting" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Cheapest lighting technology — helps a lot on weak GPUs." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding FFlagLightingTechVoxel}" IsEnabled="{Binding ApplyFFlags}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Disable voice chat" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Skips loading the voice stack — less RAM per client." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding FFlagDisableVoiceChat}" IsEnabled="{Binding ApplyFFlags}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Custom flags" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="A JSON object of raw flags, merged last so it overrides the toggles above."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,8" />
                        <TextBox MinHeight="90" FontFamily="Consolas" FontSize="11.5"
                                 Text="{Binding CustomFFlagsText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource TextArea}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomFFlagsValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding FFlagsSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Write flags now" Command="{Binding ApplyFFlagsNowCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="Clear all flags" Command="{Binding ClearFFlagsCommand}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Global hotkeys ===== -->
            <TextBlock Text="Global hotkeys" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="System-wide shortcuts that work even while Roblox has focus. Click a chord to record a new one; press Esc to cancel. A chord another app already owns is skipped silently."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding HotkeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="170"
                                            Content="{Binding DisplayText}" Focusable="True"
                                            Click="HotkeyCapture_Click" PreviewKeyDown="HotkeyCapture_KeyDown"
                                            LostKeyboardFocus="HotkeyCapture_LostFocus"
                                            ToolTip="Click, then press the chord you want" />
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="12,0,0,0"
                                              IsChecked="{Binding Enabled}" ToolTip="Enable this hotkey" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Local Web API ===== -->
            <TextBlock Text="Local API" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Enable control server" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Lets scripts on this PC drive the manager over HTTP. Bound to 127.0.0.1 only, and every request needs the token below — but anyone who can run code as you can read that token, so keep it off unless you use it."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding WebApiEnabled}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Port" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Local port to listen on." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding WebApiPort, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Bearer token" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Send as &quot;Authorization: Bearer &lt;token&gt;&quot; or ?token=…" Style="{StaticResource Caption}" Margin="0,3,0,8" />
                        <TextBox Text="{Binding WebApiToken, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="11.5" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Generate new token" Command="{Binding GenerateWebApiTokenCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="Copy token" Command="{Binding CopyWebApiTokenCommand}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" />
                        </WrapPanel>
                        <TextBlock Text="{Binding WebApiStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                            <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="GET  /ping&#10;GET  /accounts&#10;GET  /status?account=&#10;GET  /cookie?account=&#10;POST /launch?account=&amp;placeId=&amp;jobId=&#10;POST /close?account=" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Proxy ===== -->
            <TextBlock Text="Proxy" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Route Roblox web calls through a proxy" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Applies to the manager's own API traffic (login checks, presence, servers, Robux). The Roblox client itself still connects directly."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding EnableProxy}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Address" Style="{StaticResource Label}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=LostFocus}" ToolTip="host:port, http://host:port or socks5://host:port" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Username (optional)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ProxyUsername, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Password (optional)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ProxyPassword, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Test proxy" Command="{Binding TestProxyCommand}" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Interface ===== -->
            <TextBlock Text="Interface" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Hide usernames" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Mask usernames for screenshots / streaming." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding HideUsernames}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Close to tray" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Closing the window minimizes to the system tray instead of quitting. Double-click the tray icon to reopen; right-click for Exit." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding MinimizeToTray}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Appearance (#30) ===== -->
            <TextBlock Text="Appearance" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Theme preset -->
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Theme preset" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Pick a built-in palette. Editing a swatch below switches to a custom copy." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Width="170" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  ItemsSource="{Binding ThemePresets}" SelectedItem="{Binding ThemeName}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />

                    <!-- Editable colour swatches -->
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Theme colours" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Edit any swatch as #RRGGBB. A red outline marks a value that is not yet valid." Style="{StaticResource Caption}" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding ThemeColors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"
                                                Background="{Binding Hex, Converter={StaticResource HexToBrush}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Group}" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Reset to preset" Style="{StaticResource GhostButton}"
                                Command="{Binding ResetThemeCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />

                    <!-- Account view mode -->
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Account list layout" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Card shows avatars and details; Compact is a dense one-line-per-account list." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Width="170" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  ItemsSource="{Binding ViewModes}" SelectedItem="{Binding AccountViewMode}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />

                    <!-- Language -->
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                            <TextBlock Text="Language" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Interface language. Some strings apply after the next window open." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Width="170" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Notifications (#30) ===== -->
            <TextBlock Text="Notifications" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="In-app toasts" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Show brief pop-up notifications in the corner of the window." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding EnableToasts}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Notify on launch" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Raise a toast whenever a client finishes launching." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ToastOnLaunch}" IsEnabled="{Binding EnableToasts}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <Grid Margin="16,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Notify on crash" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Raise a toast when a tracked client crashes or is closed unexpectedly." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ToastOnCrash}" IsEnabled="{Binding EnableToasts}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <!-- Discord webhook (rich embeds) -->
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Discord webhook" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Send rich embed messages to a Discord channel on connect / disconnect / reconnect."
                                   Style="{StaticResource Caption}" Margin="0,3,0,8" />
                        <TextBox Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="https://discord.com/api/webhooks/..." />
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="Embed on connect" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Post an embed each time an account launches / connects." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding NotifyOnConnect}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="Embed on disconnect / reconnect" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Post embeds when a tracked client closes and when it auto-rejoins." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding NotifyOnCrash}" />
                        </Grid>
                        <Button Content="Send test embed" Command="{Binding TestWebhookCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Browser ===== -->
            <TextBlock Text="Browser" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.External}" Style="{StaticResource IconPath}" Width="16" Height="16"
                              Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ChromiumStatus}" Margin="10,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding DownloadChromiumCommand}"
                            Content="{Binding ChromiumButtonText}" Width="200" HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Plugins" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.External}" Style="{StaticResource IconPath}" Width="16" Height="16"
                              Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PluginStatus}" Margin="10,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Version, StringFormat=' v{0}'}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ReloadPluginsCommand}"
                                Content="Reload plugins" Width="150" HorizontalAlignment="Left" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenPluginsFolderCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource IconPath}" Width="15" Height="15" />
                                <TextBlock Text="Open plugins folder" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Security ===== -->
            <TextBlock Text="Security" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource IconPath}" Width="16" Height="16"
                              Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PasswordStatus}" Margin="10,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SetPasswordCommand}" Width="180">
                            <TextBlock Text="Set / change password" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RemovePasswordCommand}" Margin="10,0,0,0" Width="150"
                                Visibility="{Binding HasMasterPassword, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Remove password" />
                        </Button>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,18,0,14" />

                    <!-- Portable encrypted backup -->
                    <TextBlock Text="Backup &amp; restore" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="accounts.dat is encrypted with Windows DPAPI, which is tied to this Windows user — copying it to another PC loses everything. A backup re-encrypts your accounts with a password you choose, so it can be restored anywhere. Restoring merges: existing accounts keep their place and only get a fresh cookie."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExportBackupCommand}" Content="Create backup…" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ImportBackupCommand}" Content="Restore backup…" Margin="10,0,0,0" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,18,0,14" />

                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Check cookies on startup" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Validates every saved cookie against Roblox when the app opens, so dead accounts are marked before you try to launch them."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding ValidateCookiesOnStartup}" />
                    </Grid>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ValidateCookiesNowCommand}"
                            Content="Check all cookies now" HorizontalAlignment="Left" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Capture rotated cookies" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Roblox sometimes issues a new .ROBLOSECURITY during launch. Saving it keeps the account working; turning this off means such an account eventually stops launching."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding RotationDetectionEnabled}" />
                    </Grid>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Security audit log" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Records unlocks, launches, cookie rotations and account changes to data/audit.log. Cookie values are never written."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AuditLogEnabled}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Diagnostics ===== -->
            <TextBlock Text="Diagnostics" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding DiagnosticsStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding HealthChecks}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusGlyph}" FontFamily="Consolas" FontWeight="Bold" Width="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,2,0,0" />
                                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="24,3,0,0"
                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunHealthCheckCommand}"
                                Content="Run self-check" Width="150" IsEnabled="{Binding HealthRunning, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDiagnosticsCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource IconPath}" Width="15" Height="15" />
                                <TextBlock Text="Open log folder" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearDiagnosticsCommand}"
                                Content="Clear log" Margin="10,0,0,0" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="Client windows" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Acts on every running Roblox client, including ones started from the website."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ArrangeWindowsCommand}" Content="Arrange in a grid" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding MinimizeClientsCommand}" Content="Minimize all" Margin="10,0,0,0" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RestoreClientsCommand}" Content="Restore all" Margin="10,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== About / updates ===== -->
            <TextBlock Text="About" Style="{StaticResource DisplayText}" FontSize="15" Margin="2,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Roblox Account Manager" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding OpenDataFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource IconPath}" Width="15" Height="15" />
                                <TextBlock Text="Open data folder" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="Updates" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="The app checks GitHub automatically every 5 minutes and shows a pill in the title bar when a new release is out. Updating is always your choice — this button just checks right now."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="{Binding UpdateCheckStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" Width="170"
                                Content="Check for updates" IsEnabled="{Binding UpdateCheckRunning, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ShowWhatsNewCommand}"
                                Content="What's new in this version" Margin="10,0,0,0" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="Roblox install" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Which client a launch will actually start — including installs managed by a bootstrapper such as Bloxstrap or Froststrap."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" FontFamily="Consolas" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
