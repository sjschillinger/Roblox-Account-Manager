<Window x:Class="RobloxAccountManager.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
        Title="{DynamicResource Str.Updates.Available}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="624" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Border x:Name="Root" Margin="22" CornerRadius="{StaticResource RadiusLg}"
            Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            Effect="{StaticResource ShadowDialog}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="24,22,24,16" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Updates.Available}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource Badge}" Padding="9,2,9,3">
                            <TextBlock x:Name="CurrentVersionText" FontSize="12" />
                        </Border>
                        <Path Data="{StaticResource Icon.ArrowRight}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="8,0"
                              Stroke="{DynamicResource TextMutedBrush}" />
                        <Border Style="{StaticResource Badge}" Padding="9,2,9,3" Background="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="NewVersionText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                    </StackPanel>
                    <WrapPanel x:Name="MetaPanel" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <!-- Release notes -->
            <Border Grid.Row="1" Margin="24,0,24,20" Style="{StaticResource Panel}" Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,8,12">
                    <StackPanel x:Name="NotesPanel" Margin="0,0,8,4" />
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,11,11"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16,14,24,14">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" ctl:Ui.Icon="{StaticResource Icon.External}" HorizontalAlignment="Left"
                            Content="{DynamicResource Str.Updates.ViewRelease}" Click="ViewOnGitHub_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource Str.Updates.Skip}" Margin="0,0,8,0" Click="Skip_Click"
                                ToolTip="{DynamicResource Str.Updates.Skip.Tip}" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="{DynamicResource Str.Updates.Later}" Margin="0,0,8,0" Click="Later_Click" />
                        <Button Style="{StaticResource Btn.Primary}" ctl:Ui.Icon="{StaticResource Icon.Download}"
                                Content="{DynamicResource Str.Updates.Install}" Click="UpdateNow_Click" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
