<Window x:Class="RobloxAccountManager.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
        Title="{DynamicResource Str.Updates.WhatsNew}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="624" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Border x:Name="Root" Margin="22" CornerRadius="{StaticResource RadiusLg}"
            Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            Effect="{StaticResource ShadowDialog}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="24,22,24,16" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.Updates.WhatsNew}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="9,2,9,3">
                            <TextBlock x:Name="VersionChip" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Segmented}" VerticalAlignment="Center" x:Name="HistorySwitch">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThisVersionTab" GroupName="notes" Style="{StaticResource Segment}" IsChecked="True"
                                     Content="{DynamicResource Str.Updates.ThisVersion}" Checked="Notes_Checked" />
                        <RadioButton x:Name="HistoryTab" GroupName="notes" Style="{StaticResource Segment}"
                                     Content="{DynamicResource Str.Updates.History}" Checked="Notes_Checked" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="24,0,24,20" Style="{StaticResource Panel}">
                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" Padding="16,12,8,12">
                    <StackPanel x:Name="NotesPanel" Margin="0,0,8,4" />
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,11,11"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16,14,24,14">
                <Grid>
                    <Button Style="{StaticResource Btn.Ghost}" ctl:Ui.Icon="{StaticResource Icon.External}" HorizontalAlignment="Left"
                            Content="{DynamicResource Str.Updates.ViewRelease}" Click="ViewOnGitHub_Click" />
                    <Button Style="{StaticResource Btn.Primary}" MinWidth="96" HorizontalAlignment="Right"
                            Content="{DynamicResource Str.Common.Done}" Click="Close_Click" IsDefault="True" IsCancel="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
