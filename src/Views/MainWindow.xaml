<Window x:Class="RobloxAccountManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:RobloxAccountManager.Controls"
        xmlns:vm="clr-namespace:RobloxAccountManager.ViewModels"
        xmlns:views="clr-namespace:RobloxAccountManager.Views"
        Title="Roblox Account Manager"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1280" Height="800" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        WindowStyle="None"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Accounts.AddCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavCommand}" CommandParameter="4" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavCommand}" CommandParameter="5" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Sidebar navigation entry -->
        <ControlTemplate x:Key="NavButtonTemplate" TargetType="Button">
            <Border x:Name="bd" CornerRadius="{StaticResource RadiusMd}" Height="34" Padding="10,0" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="ic" Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                          Style="{StaticResource IconPath}" Width="17" Height="17" />
                    <TextBlock x:Name="tx" Grid.Column="1" Text="{Binding Title}" Margin="11,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="badge" Grid.Column="2" Text="{Binding Badge}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,2,0" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                    <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter TargetName="ic" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                    <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter TargetName="ic" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="tx" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="bd" Property="Padding" Value="0" />
                    <Setter TargetName="ic" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="ic" Property="Grid.ColumnSpan" Value="3" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template" Value="{StaticResource NavButtonTemplate}" />
        </Style>

        <Style x:Key="PageHost" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
            TextElement.FontFamily="{StaticResource UiFont}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== SIDEBAR ============================== -->
            <Border Grid.Column="0" Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <Grid Grid.Row="0" Margin="16,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <BitmapImage UriSource="pack://application:,,,/Assets/app.ico" DecodePixelWidth="48" />
                                </Image.Source>
                            </Image>
                            <TextBlock x:Name="BrandText" Text="Account Manager" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding SidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Search / command palette -->
                    <Button Grid.Row="1" Margin="12,0,12,10" Command="{Binding OpenPaletteCommand}" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" FocusVisualStyle="{StaticResource FocusRing}"
                            ToolTip="{DynamicResource Str.Palette.Tooltip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Height="32" CornerRadius="{StaticResource RadiusMd}" Padding="10,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="ic" Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}" Width="14" Height="14"
                                              Stroke="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="tx" Grid.Column="1" Text="{DynamicResource Str.Palette.Search}" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <Border x:Name="kbd" Grid.Column="2" Style="{StaticResource Kbd}">
                                            <TextBlock Text="Ctrl K" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter TargetName="tx" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="kbd" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ic" Property="HorizontalAlignment" Value="Center" />
                                        <Setter TargetName="ic" Property="Grid.ColumnSpan" Value="3" />
                                        <Setter TargetName="bd" Property="Padding" Value="0" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Navigation + groups -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,0,10,10">
                            <ItemsControl ItemsSource="{Binding NavItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NavItem}">
                                        <Button Style="{StaticResource NavButton}"
                                                Command="{Binding DataContext.NavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Index}">
                                            <Button.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Shortcut, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                                </TextBlock>
                                            </Button.ToolTip>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Groups -->
                            <StackPanel Margin="0,18,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGroups}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource Str.Nav.Groups}" Margin="10,0,0,6" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GroupNavItem}">
                                            <Button Cursor="Hand" Margin="0,1" FocusVisualStyle="{StaticResource FocusRing}"
                                                    Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" CornerRadius="{StaticResource RadiusMd}" Height="30" Padding="10,0" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource IconPath}" Width="15" Height="15"
                                                                      Stroke="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock x:Name="tx" Grid.Column="1" Text="{Binding Name}" Margin="11,0,0,0" VerticalAlignment="Center"
                                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <Ellipse Grid.Column="2" Style="{StaticResource StatusDot}" Width="6" Height="6" Margin="8,0,5,0"
                                                                         Fill="{DynamicResource PresenceInGameBrush}"
                                                                         Visibility="{Binding Online, Converter={StaticResource PositiveToVis}}"
                                                                         ToolTip="{Binding Online}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Count}" VerticalAlignment="Center" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,2,0" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom -->
                    <StackPanel Grid.Row="3" Margin="10,0,10,10">
                        <!-- Update available -->
                        <Button Margin="0,0,0,8" Cursor="Hand" Command="{Binding UpdateNowCommand}"
                                FocusVisualStyle="{StaticResource FocusRing}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="{DynamicResource Str.Update.PillTip}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str.Update.Skip}"
                                              Command="{Binding PlacementTarget.DataContext.SkipUpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource Icon.Download}" Style="{StaticResource IconPath}" Width="15" Height="15"
                                                  Stroke="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel x:Name="text" Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{DynamicResource Str.Update.Pill}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding UpdateVersionText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                            <Setter TargetName="text" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Style="{StaticResource Divider}" Margin="4,0,4,8" />

                        <Button Style="{StaticResource NavButton}" DataContext="{Binding SettingsNav}"
                                Command="{Binding DataContext.NavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Index}" ToolTip="{Binding Title}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Btn.Icon}" ctl:Ui.Icon="{StaticResource Icon.Sidebar}"
                                    Command="{Binding ToggleSidebarCommand}" ToolTip="{DynamicResource Str.Nav.ToggleSidebar}" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" ctl:Ui.Icon="{StaticResource Icon.Lock}"
                                    Command="{Binding LockCommand}" ToolTip="{DynamicResource Str.Nav.Lock}"
                                    Visibility="{Binding CanLock, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== CONTENT ============================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ClipToBounds="True">
                    <views:DashboardPage DataContext="{Binding Dashboard}" Style="{StaticResource PageHost}"
                                         Visibility="{Binding DataContext.SelectedIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />
                    <views:AccountsPage DataContext="{Binding Accounts}" Style="{StaticResource PageHost}"
                                        Visibility="{Binding DataContext.SelectedIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=1}" />
                    <views:FriendsPage DataContext="{Binding Friends}" Style="{StaticResource PageHost}"
                                       Visibility="{Binding DataContext.SelectedIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=2}" />
                    <views:ServerBrowserPage DataContext="{Binding Servers}" Style="{StaticResource PageHost}"
                                             Visibility="{Binding DataContext.SelectedIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=3}" />
                    <views:AutomationPage DataContext="{Binding Automation}" Style="{StaticResource PageHost}"
                                          Visibility="{Binding DataContext.SelectedIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=4}" />
                    <views:SettingsPage DataContext="{Binding Settings}" Style="{StaticResource PageHost}"
                                        Visibility="{Binding DataContext.SelectedIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=5}" />
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="18,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Status}" />
                        <Button Grid.Column="1" Style="{StaticResource Btn.Link}" Margin="16,0,0,0" VerticalAlignment="Center"
                                Command="{Binding NavCommand}" CommandParameter="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Setter Property="Fill" Value="{DynamicResource PresenceOfflineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunningClients, Converter={StaticResource PositiveToVis}}" Value="Visible">
                                                    <Setter Property="Fill" Value="{DynamicResource PresenceInGameBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding RunningText}" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding AppVersionShort}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </Border>

            </Grid>

            <!-- ============================== TOASTS ============================== -->
            <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}" Focusable="False"
                          VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          Margin="0,0,18,40" Width="360" Panel.ZIndex="50">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="card" Background="{DynamicResource ElevatedBrush}" CornerRadius="{StaticResource RadiusLg}"
                                BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                                Margin="0,8,0,0" Padding="14,12,8,12" Effect="{StaticResource ShadowFloating}"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="slide" Y="12" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="icon" Data="{StaticResource Icon.Info}" Style="{StaticResource IconPath}" Width="17" Height="17"
                                      VerticalAlignment="Top" Margin="0,1,0,0" Stroke="{DynamicResource InfoBrush}" />
                                <StackPanel Grid.Column="1" Margin="11,0,6,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="24" Height="24" VerticalAlignment="Top"
                                        Command="{Binding DismissCommand}" ToolTip="{DynamicResource Str.Common.Dismiss}">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" Width="10" Height="10" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Success">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource Icon.CheckCircle}" />
                                <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource Icon.Alert}" />
                                <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource Icon.XCircle}" />
                                <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================== MODAL SCRIM ============================== -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" Panel.ZIndex="80"
                    Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}" />

            <!-- ============================== COMMAND PALETTE ============================== -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="90" DataContext="{Binding Palette}"
                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                  IsVisibleChanged="Palette_IsVisibleChanged">
                <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="PaletteScrim_MouseDown" />
                <Border Width="640" VerticalAlignment="Top" Margin="0,96,0,0" CornerRadius="{StaticResource RadiusLg}"
                        Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                        Effect="{StaticResource ShadowDialog}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,0,14,0" Height="54">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}" Width="17" Height="17"
                                  Stroke="{DynamicResource TextMutedBrush}" />
                            <TextBox x:Name="PaletteInput" Grid.Column="1" Margin="8,0,0,0" FontSize="15" Height="40"
                                     Background="Transparent" BorderThickness="0" Padding="4,0"
                                     ctl:Ui.Placeholder="{DynamicResource Str.Palette.Placeholder}"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                            <Border Grid.Column="2" Style="{StaticResource Kbd}">
                                <TextBlock Text="Esc" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Divider}" />
                        <Grid Grid.Row="2">
                            <ListBox x:Name="PaletteList" Style="{StaticResource PlainList}" MaxHeight="420" Padding="6"
                                     ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     MouseLeftButtonUp="PaletteList_MouseUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaletteItem}">
                                        <Grid Height="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="icon" Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                  Style="{StaticResource IconPath}" HorizontalAlignment="Left" />
                                            <ctl:AvatarView x:Name="avatar" Width="24" Height="24" CornerRadius="7" PipSize="8"
                                                            HorizontalAlignment="Left" Visibility="Collapsed"
                                                            RingBrush="{DynamicResource ElevatedBrush}"
                                                            ImageUrl="{Binding ImageUrl}" NameText="{Binding Title}" Presence="{Binding Presence}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Kbd}" Margin="8,0,4,0"
                                                    Visibility="{Binding Shortcut, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding Shortcut}" />
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAccount}" Value="True">
                                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="avatar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{DynamicResource Str.Palette.NoResults}" Margin="20,22" Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding Results.Count, Converter={StaticResource CountZeroToVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================== LOCK SCREEN ============================== -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="100" Background="{DynamicResource CanvasBrush}"
                  Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                  IsVisibleChanged="Lock_IsVisibleChanged">
                <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Center" Background="{DynamicResource SurfaceAltBrush}">
                        <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource IconPath}" Width="22" Height="22"
                              Stroke="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Str.Lock.Title}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="{DynamicResource Str.Lock.Body}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,0,0,20" />
                    <PasswordBox x:Name="UnlockBox" ctl:Ui.Placeholder="{DynamicResource Str.Lock.Placeholder}" Height="38">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding UnlockCommand}" CommandParameter="{Binding ElementName=UnlockBox}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <TextBlock Text="{Binding UnlockError}" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" Margin="2,8,0,0"
                               TextWrapping="Wrap" Visibility="{Binding UnlockError, Converter={StaticResource NullToVis}}" />
                    <Button Style="{StaticResource Btn.Primary}" Height="38" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Content="{DynamicResource Str.Lock.Unlock}" Command="{Binding UnlockCommand}"
                            CommandParameter="{Binding ElementName=UnlockBox}" />
                </StackPanel>
            </Grid>
            <!-- Caption buttons: above every overlay, so the window can always be moved, minimised or closed -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Panel.ZIndex="110" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Caption}" Click="Minimize_Click" ToolTip="{DynamicResource Str.Window.Minimize}">
                    <Path Data="{StaticResource Icon.Minimize}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Click="Maximize_Click" ToolTip="{DynamicResource Str.Window.Maximize}">
                    <Path x:Name="MaxIcon" Data="{StaticResource Icon.Maximize}" Style="{StaticResource IconPath}" Width="10" Height="10" StrokeThickness="1.4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource Btn.CaptionClose}" Click="Close_Click" ToolTip="{DynamicResource Str.Window.Close}">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource IconPath}" Width="11" Height="11" StrokeThickness="1.4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
